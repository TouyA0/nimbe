<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Savoir si le stick a du réseau et internet, pour l'écran « Pas d'internet ». -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Mises à jour (releases GitHub) et serveurs de la maison (Jellyfin). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installer la nouvelle version de Nimbe. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ouvrir l'écran de désinstallation d'Android (qui demande lui-même confirmation). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ : rendre visibles les applis lançables, pour l'écran Applis. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Trouver l'accueil d'origine, pour l'écran Secours. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".NimbeApplication"
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nimbe">
        <!-- HOME + DEFAULT : Nimbe peut être choisi comme écran d'accueil du stick.
             L'accueil d'origine reste installé : c'est le secours. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google TV garde la touche Accueil pour lui : ce service la rend à Nimbe (voir HomeKeyService). -->
        <service
            android:name=".homekey.HomeKeyService"
            android:exported="true"
            android:label="@string/home_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- Résultat d'une installation de mise à jour, envoyé par Android à Nimbe seulement. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
